# ------------------------------------------------------------------
# Donair Choices Cafe — backend environment (TEMPLATE)
# Copy this file to `.env` and fill in the real values.
# NEVER commit the real .env (it is git-ignored).
# ------------------------------------------------------------------

# MongoDB Atlas connection string.
# Format: mongodb+srv://<username>:<password>@<cluster-host>/?options
MONGODB_URI="mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<your-cluster>.mongodb.net/?retryWrites=true&w=majority&appName=DONAIR"

# Database + default collection names the app will use
DB_NAME="donair_choices"

# Server (for a future API)
PORT=4000
# Comma-separated list of sites allowed to call the API (CORS)
ALLOWED_ORIGINS="https://donairchoicescafe.ca,https://www.donairchoicescafe.ca,http://localhost:5173"
